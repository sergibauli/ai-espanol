{"titulo": "El nuevo amigo de Li Wei", "tituloZh": "李伟的新朋友", "escena": "🏫", "lineas": [{"quien": "narrador", "emocion": "neutral", "es": "En la escuela de español, Li Wei conoce a Mei.", "zh": "在西班牙语学校，李伟认识了梅。"}, {"quien": "liwei", "emocion": "feliz", "es": "¡Hola! Me llamo Li Wei. ¿Y tú?", "zh": "你好！我叫李伟。你呢？"}, {"quien": "mei", "emocion": "feliz", "es": "Hola, soy Mei. Mucho gusto.", "zh": "你好，我是梅。很高兴认识你。"}, {"quien": "liwei", "emocion": "curioso", "es": "Igualmente. ¿De dónde eres?", "zh": "我也很高兴。你来自哪里？"}, {"quien": "mei", "emocion": "neutral", "es": "Soy de Pekín. ¿Y tú?", "zh": "我来自北京。你呢？"}, {"quien": "liwei", "emocion": "neutral", "es": "Soy de Shanghái. Vivo en Madrid.", "zh": "我来自上海。我住在马德里。"}, {"quien": "mei", "emocion": "duda", "es": "¿A qué te dedicas?", "zh": "你是做什么工作的？"}, {"quien": "liwei", "emocion": "feliz", "es": "Soy estudiante. Estudio español.", "zh": "我是学生。我学习西班牙语。"}, {"quien": "carlos", "emocion": "feliz", "es": "¡Hola! Este es mi amigo Li Wei.", "zh": "你好！这是我的朋友李伟。"}, {"quien": "mei", "emocion": "sorpresa", "es": "Encantada. ¿Él es de China?", "zh": "很高兴认识你。他来自中国吗？"}, {"quien": "carlos", "emocion": "neutral", "es": "Sí, es de Shanghái. Es un placer.", "zh": "是的，他来自上海。很荣幸。"}, {"quien": "liwei", "emocion": "risa", "es": "El gusto es mío. ¡Bienvenida!", "zh": "荣幸的是我。欢迎！"}, {"quien": "mei", "emocion": "feliz", "es": "Gracias. ¡Hasta luego!", "zh": "谢谢。回头见！"}], "preguntas": [{"despues": 3, "pregunta": "¿Cómo se llama el chico?", "preguntaZh": "那个男孩叫什么名字？", "opciones": ["Li Wei", "Mei", "Carlos"], "correcta": 0}, {"despues": 7, "pregunta": "¿De dónde es Mei?", "preguntaZh": "梅来自哪里？", "opciones": ["Shanghái", "Pekín", "Madrid"], "correcta": 1}, {"despues": 10, "pregunta": "¿Quién presenta a Li Wei?", "preguntaZh": "谁介绍李伟？", "opciones": ["Mei", "Carlos", "Lucía"], "correcta": 1}], "moraleja": {"es": "Para presentarte, di: «Me llamo...» o «Soy...». Para preguntar: «¿Cómo te llamas?» y «¿De dónde eres?».", "zh": "自我介绍时说“Me llamo...”或“Soy...”。问别人时说“¿Cómo te llamas?”和“¿De dónde eres?”。"}}