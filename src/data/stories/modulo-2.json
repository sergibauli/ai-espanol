{"titulo": "Las palabras mágicas de Lucía", "tituloZh": "露西亚的魔法词语", "escena": "🏫", "lineas": [{"quien": "narrador", "emocion": "neutral", "es": "En una clase de español en Madrid, Lucía enseña las palabras mágicas.", "zh": "在马德里的一堂西班牙语课上，露西亚教魔法词语。"}, {"quien": "lucia", "emocion": "feliz", "es": "¡Hola, Li Wei! ¿Cómo estás?", "zh": "你好，李伟！你好吗？"}, {"quien": "liwei", "emocion": "neutral", "es": "Bien, gracias. ¿Y tú?", "zh": "很好，谢谢。你呢？"}, {"quien": "lucia", "emocion": "risa", "es": "¡Muy bien! Hoy aprendemos «por favor» y «gracias».", "zh": "很好！今天我们学习“请”和“谢谢”。"}, {"quien": "liwei", "emocion": "duda", "es": "¿Y «de nada»?", "zh": "那“不客气”呢？"}, {"quien": "lucia", "emocion": "feliz", "es": "¡Exacto! También «no hay de qué».", "zh": "没错！还有“没什么”。"}, {"quien": "mei", "emocion": "feliz", "es": "Lucía, ¿puedo tomar agua, por favor?", "zh": "露西亚，请问我可以喝水吗？"}, {"quien": "lucia", "emocion": "neutral", "es": "Claro. Aquí tienes. ¡Buen provecho!", "zh": "当然。给你。祝你好胃口！"}, {"quien": "mei", "emocion": "sorpresa", "es": "¡Mil gracias! Qué detalle.", "zh": "万分感谢！真贴心。"}, {"quien": "liwei", "emocion": "neutral", "es": "Perdón, ¿y para estornudar?", "zh": "抱歉，那打喷嚏时说什么？"}, {"quien": "lucia", "emocion": "risa", "es": "¡Salud! Y si alguien estornuda, di «salud».", "zh": "“健康”！如果有人打喷嚏，就说“健康”。"}, {"quien": "carlos", "emocion": "feliz", "es": "¡Hola! Aquí hay café. Con permiso.", "zh": "你好！这里有咖啡。借过。"}, {"quien": "lucia", "emocion": "feliz", "es": "Gracias, Carlos. ¡Eres muy amable!", "zh": "谢谢，卡洛斯。你真好！"}, {"quien": "carlos", "emocion": "neutral", "es": "De nada. Para eso estamos.", "zh": "不客气。朋友就是用来做这个的。"}], "preguntas": [{"despues": 3, "pregunta": "¿Qué aprende Li Wei hoy?", "preguntaZh": "李伟今天学什么？", "opciones": ["Los números", "Las palabras mágicas", "Los colores"], "correcta": 1}, {"despues": 7, "pregunta": "¿Qué dice Lucía cuando alguien va a comer?", "preguntaZh": "当有人要吃饭时，露西亚说什么？", "opciones": ["¡Salud!", "¡Buen provecho!", "¡Gracias!"], "correcta": 1}, {"despues": 11, "pregunta": "¿Qué dice Carlos al final?", "preguntaZh": "卡洛斯最后说什么？", "opciones": ["No hay de qué", "Para eso estamos", "Lo siento"], "correcta": 1}], "moraleja": {"es": "Usa «por favor» y «gracias» todos los días.", "zh": "每天都要说“请”和“谢谢”。"}}