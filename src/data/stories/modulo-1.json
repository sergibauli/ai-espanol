{"titulo": "El primer día de Li Wei", "tituloZh": "李伟的第一天", "escena": "🏫", "lineas": [{"quien": "narrador", "emocion": "neutral", "es": "Es lunes por la mañana en la escuela de español.", "zh": "星期一早上，在西班牙语学校。"}, {"quien": "lucia", "emocion": "feliz", "es": "¡Hola! Buenos días. ¿Cómo estás?", "zh": "你好！早上好。你好吗？"}, {"quien": "liwei", "emocion": "duda", "es": "Buenos días... ¿Qué tal? Yo... bien, gracias.", "zh": "早上好……怎么样？我……很好，谢谢。"}, {"quien": "lucia", "emocion": "risa", "es": "¡Muy bien! ¿Todo bien?", "zh": "很好！一切都好吗？"}, {"quien": "liwei", "emocion": "neutral", "es": "Regular. Un poco nervioso.", "zh": "一般般。有点紧张。"}, {"quien": "lucia", "emocion": "feliz", "es": "No te preocupes. ¡Hasta luego!", "zh": "别担心。回头见！"}, {"quien": "narrador", "emocion": "neutral", "es": "Por la tarde, Li Wei ve a Mei.", "zh": "下午，李伟看到梅。"}, {"quien": "mei", "emocion": "feliz", "es": "¡Hola! Buenas tardes. ¿Cómo te va?", "zh": "你好！下午好。你最近怎么样？"}, {"quien": "liwei", "emocion": "sorpresa", "es": "¡Fenomenal! ¿Y tú?", "zh": "棒极了！你呢？"}, {"quien": "mei", "emocion": "neutral", "es": "Bien, gracias. ¡Cuánto tiempo!", "zh": "好，谢谢。好久不见！"}, {"quien": "liwei", "emocion": "feliz", "es": "Sí. Buenas noches, hasta mañana.", "zh": "是的。晚安，明天见。"}, {"quien": "mei", "emocion": "risa", "es": "¡Chao! Cuídate. Un abrazo.", "zh": "拜拜！保重。一个拥抱。"}], "preguntas": [{"despues": 3, "pregunta": "¿Cómo está Li Wei?", "preguntaZh": "李伟怎么样？", "opciones": ["Bien", "Mal", "Regular"], "correcta": 2}, {"despues": 7, "pregunta": "¿Qué dice Mei para saludar por la tarde?", "preguntaZh": "梅下午用什么问候？", "opciones": ["Buenos días", "Buenas tardes", "Buenas noches"], "correcta": 1}, {"despues": 11, "pregunta": "¿Qué dice Mei al despedirse?", "preguntaZh": "梅告别时说了什么？", "opciones": ["Hasta luego", "Chao", "Hasta pronto"], "correcta": 1}], "moraleja": {"es": "Usa 'hola' y 'adiós' en cada situación, y pregunta '¿cómo estás?' para ser amable.", "zh": "在每个场合使用‘你好’和‘再见’，并问‘你好吗？’来表示友好。"}}